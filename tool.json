{
  "id": "census-lens",
  "title": "Census Lens",
  "description": "Compare 2021 Census community profiles or see how the numbers of children and seniors changed across Canadian metropolitan areas.",
  "category": "explorers",
  "tags": [
    "census",
    "housing",
    "population",
    "income",
    "municipalities"
  ],
  "icon": "building-2",
  "url": "/census-lens/",
  "source": "https://github.com/jsdyer/census-lens",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "Statistics Canada’s 2021 Census Profile supplies community indicators. Table 17-10-0148-01 supplies annual July 1 age estimates for metropolitan areas and agglomerations.",
    "cadence": "Quarterly",
    "probes": [
      {
        "url": "https://coolcode.ca/census-lens/data/status.json",
        "path": [
          "retrieved"
        ],
        "label": "Source retrieved",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "places"
        }
      },
      {
        "url": "https://coolcode.ca/census-lens/data/status.json",
        "path": [
          "start"
        ],
        "end_path": [
          "end"
        ],
        "label": "Coverage"
      },
      {
        "url": "https://coolcode.ca/census-lens/data/age-estimates.json",
        "path": [
          "checked"
        ],
        "label": "Metropolitan estimates checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "areas"
        }
      }
    ]
  }
}
